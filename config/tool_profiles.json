{
  "version": 1,
  "description": "角色工具策略。resident为常驻工具名；on_demand可用工具名或domain:领域，覆盖默认按需范围；disabled优先。角色键为稳定scope，未配置角色继承defaults。现有人设tool_access继续作为额外权限限制。",
  "defaults": {
    "resident": [
      "search_tools",
      "manage_todo",
      "search_chat_history"
    ],
    "on_demand": [
      "domain:todo",
      "domain:core",
      "domain:information",
      "domain:daily_record",
      "domain:journal",
      "domain:plan",
      "domain:file",
      "domain:food",
      "domain:shop",
      "domain:study",
      "domain:study_teaching",
      "domain:reminder",
      "domain:user_status",
      "domain:health",
      "domain:memory_search",
      "domain:memory_write",
      "domain:companion",
      "domain:communication",
      "domain:active_care",
      "domain:device_observe",
      "domain:device_control",
      "domain:scene",
      "domain:tool_discovery"
    ],
    "disabled": []
  },
