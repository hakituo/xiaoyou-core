{
  "name": "aveline-ui-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.aveline.ai",
    "productName": "Aveline AI",
    "directories": {
      "output": "dist_electron_build4"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../../../dist/XiaoyouCore",
        "to": "backend",
        "filter": [
          "**/*",
          "!_internal/torch{,/**/*}",
          "!_internal/bitsandbytes{,/**/*}",
          "!_internal/onnxruntime{,/**/*}",
          "!_internal/llvmlite{,/**/*}",
          "!_internal/scipy{,/**/*}",
          "!_internal/scipy.libs{,/**/*}"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aveline AI"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@react-three/drei": "^9.88.0",
    "@react-three/fiber": "^8.15.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.182.0",
    "capacitor-voice-recorder": "^7.0.6",
    "clsx": "^1.2.1",
    "cordova-plugin-background-mode": "^0.7.3",
    "cordova-plugin-device": "^3.0.0",
    "electron-updater": "^6.6.2",
    "framer-motion": "^10.12.7",
    "katex": "^0.16.27",
    "lucide-react": "^0.554.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-window": "^1.8.7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/estree": "^1.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "astral-regex": "^2.0.0",
    "autoprefixer": "^10.4.22",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.6",
    "slice-ansi": "^7.1.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.1.6",
    "vite": "^5.0.0"
  }
}
