# xiaoyou-core 环境变量配置
# 复制此文件为 .env 并填充实际值

# 基础配置
DEBUG=False
LOG_LEVEL=INFO

# API配置
API_PORT=8000
API_HOST=0.0.0.0

# 代理配置（可选）
PROXY_ENABLED=False
PROXY_URL=http://127.0.0.1:7890

# TTS配置
TTS_SKIP_MODEL_VALIDATION=False
TTS_DOWNLOAD_AT_INIT=True
TTS_DEFAULT_VOICE=zh-CN

# 模型配置
MODEL_TYPE=transformers  # transformers, ollama, vllm, infer_service
TEXT_MODEL_PATH=./models/text
VISION_MODEL_PATH=./models/vision
IMAGE_GEN_MODEL_PATH=./models/image_gen

# Ollama配置（如果使用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# VLLM配置（如果使用）
VLLM_BASE_URL=http://localhost:8000/generate

# 推理服务配置（如果使用）
INFER_SERVICE_URL=http://localhost:8001
INFER_SERVICE_API_KEY=

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# QQ机器人配置
QQ_BOT_CALLBACK_TOKEN=your_secure_token_here
QQ_BOT_ENABLE_WEBHOOK=True
QQ_BOT_WEBHOOK_SECRET=your_webhook_secret_here

# 主用户 QQ 号（master QQ id），用于会话 ID 拼接、Obsidian 默认会话等
# 代码中不再硬编码，必须在此配置
XIAOYOU_QQ_MASTER_ID=

# 量化配置
MODEL_USE_QUANTIZATION=False
MODEL_QUANTIZATION_BITS=8  # 4或8

# 安全配置
DISABLE_DEVICE_FINGERPRINT=True  # 是否禁用设备指纹以减少风控

# 云端模型配置
# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# DashScope/通义千问配置 - 固定使用 Qwen 3.5 Plus
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DashScope 仅支持 qwen3.5-plus，不支持其他模型

# SiliconFlow 配置
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 默认模型选择（影响所有云端模型）
DEFAULT_MODEL=deepseek-v4-pro  # 设置默认使用的模型

# Telegram 机器人配置
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ENABLE_TELEGRAM_VOICE=true
ENABLE_TELEGRAM_VISION=true
TELEGRAM_STRIP_MARKDOWN=true

# 和风天气 QWeather 配置（JWT 认证）
# 申请地址：https://console.qweather.com/
# 1. 控制台创建项目，生成 Ed25519 密钥对，公钥上传到凭据
# 2. 私钥保存到 config/qweather_private_key.pem（.gitignore 已忽略 *.pem）
# 3. API Host 在控制台-设置里查看（每个开发者独立）
QWEATHER_API_HOST=your_api_host.qweatherapi.com
QWEATHER_CREDENTIAL_ID=your_credential_id
QWEATHER_PROJECT_ID=your_project_id
QWEATHER_PRIVATE_KEY_PATH=config/qweather_private_key.pem
QWEATHER_DEFAULT_LOCATION=
