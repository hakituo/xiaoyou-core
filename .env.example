# xiaoyou-core 环境变量模板
#
# 用法：复制本文件为 .env 后填值。.env 已被 .gitignore 排除，真实凭据绝不入库。
#
# ── 命名约定（2026-09-24 校正）────────────────────────────────────────────
# 1) config/ 下的 pydantic 配置按 `SettingsConfigDict(env_prefix=...)` 读取，必须带前缀，
#    例如 XIAOYOU_VOICE_ENABLED、XIAOYOU_STUDY_ENABLED、XIAOYOU_SCHEDULER_ENABLED，
#    嵌套字段用 `XIAOYOU_DEBUG__LIFE_SIMULATION` 这种双下划线写法。
#    无前缀的裸键不会被读取：原模板里的 TEXT_MODEL_PATH、VISION_MODEL_PATH、
#    IMAGE_GEN_MODEL_PATH、MODEL_TYPE、MODEL_USE_QUANTIZATION、MODEL_QUANTIZATION_BITS、
#    DISABLE_DEVICE_FINGERPRINT、API_HOST、API_PORT、PROXY_ENABLED、PROXY_URL、
#    INFER_SERVICE_URL、INFER_SERVICE_API_KEY、QQ_BOT_CALLBACK_TOKEN、
#    QQ_BOT_ENABLE_WEBHOOK、QQ_BOT_WEBHOOK_SECRET、TTS_SKIP_MODEL_VALIDATION、
#    TTS_DOWNLOAD_AT_INIT、TTS_DEFAULT_VOICE、OLLAMA_BASE_URL、OLLAMA_MODEL_NAME、
#    VLLM_BASE_URL、REDIS_HOST、REDIS_PORT、REDIS_DB、REDIS_PASSWORD、
#    LOG_LEVEL、DEFAULT_MODEL（这两个是 config/integrated_config.py 的旧名映射，
#    从 settings 读、不从环境变量读）共 29 个键在代码里没有任何读取点，已删除。
#    （唯一例外是 DEBUG：它只被 cpp_modules/cpp_memory_index 的构建脚本读取，
#     见第 8 段。）
# 2) 另一部分字段由代码直接 os.getenv 读取，按下面各段给出的名字写即可。
# 3) 本地模型“路径”不通过环境变量配置，统一声明在
#    config/yaml/sections/modeling.yaml（详见 config/README.md）；
#    下面只有 XIAOYOU_TEXT_MODEL_PATH / XIAOYOU_SD_MODEL_PATH 两个临时覆盖口子。
# 4) 行首带 `#` 的是可选项，不写就用代码默认值。注意不要写成 `KEY=`（空值会被当成
#    “显式设为空字符串”，反而覆盖掉代码里的默认值）。

# ── 1. 云端模型 ──────────────────────────────────────────────────────────
# 主对话默认走 DeepSeek（见 config/yaml/sections/modeling.yaml 的 model.llm.provider）
DEEPSEEK_API_KEY=
# 多 key：同一供应商可按角色 / QQ 号分配不同 key，规则 <PROVIDER>_API_KEY_<别名>。
# 别名会被转成小写（DEEPSEEK_API_KEY_Aveline → 别名 aveline），
# 路由里用 cloud:deepseek:aveline:<model> 指定。
#DEEPSEEK_API_KEY_Aveline=
#DEEPSEEK_API_KEY_Ling=
#DEEPSEEK_API_KEY_Yeye=
#DEEPSEEK_API_KEY_Rushuang=
#DEEPSEEK_API_KEY_OBSIDIAN=
#DEEPSEEK_API_KEY_QQBOT1=
#DEEPSEEK_API_KEY_QQBOT2=
# 供应商地址可用 <PROVIDER>_BASE_URL 覆盖（默认值见 config/settings_model.py 的 PROVIDER_BASE_URLS）
#DEEPSEEK_BASE_URL=

# 通义千问（被 config/yaml/app.yaml 以 ${DASHSCOPE_API_KEY} 引用；仅支持 qwen3.5-plus）
DASHSCOPE_API_KEY=
# 硅基流动（视觉模型默认走这里，被 modeling.yaml 以 ${SILICONFLOW_API_KEY} 引用）
SILICONFLOW_API_KEY=
# 其余可选供应商（能配的 provider 见 config/settings_model.py 的 SUPPORTED_PROVIDERS）
#OPENROUTER_API_KEY=
#MINIMAX_API_KEY=
#ZHIPU_API_KEY=
#ARK_API_KEY=
#OPENAI_API_KEY=
#OPENAI_DEFAULT_MODEL=
# aveline（第三方中转，base_url 必须自己填；不填则该项不可用）
#AVELINE_API_KEY=
#AVELINE_BASE_URL=
#AVELINE_MODEL=
# 联网搜索工具
#BOCHA_API_KEY=
#SERPER_API_KEY=

# ── 2. 语音（TTS / STT）──────────────────────────────────────────────────
# 默认 TTS 引擎是火山（config/yaml/app.yaml 的 voice.default_engine=volcano）
VOLC_APPID=
VOLC_API_KEY=
# 按角色分配的火山 key（被 config/yaml/app.yaml 以 ${VOLC_API_KEY_*} 引用）；
# 音色 ID（S_ 开头）直接写在 app.yaml 的 voice.voice_map 里，不通过环境变量配置
#VOLC_API_KEY_MEIMEI=
#VOLC_API_KEY_LING=
#VOLC_API_KEY_VOICE_ARTIST=
# 资源 ID（默认按“声音复刻(ICL)”授权，账号开通其它资源时才需要覆盖）
#VOLC_RESOURCE_ID=
# 云端 TTS / STT 的 OpenAI 兼容端点（不填用各家默认地址）
#TTS_API_BASE=
#STT_API_BASE=
# 置 1 可临时关闭 TTS 磁盘缓存（排查问题时用）
#TTS_CACHE_DISABLED=
# 参考音频与自动配文
#XIAOYOU_TTS_DEFAULT_REF_WAV=
#XIAOYOU_TTS_AUTO_PROMPT_TEXT=
#XIAOYOU_VOICE_ALLOW_MODEL_VOICE_TAG=
#XIAOYOU_VOICE_AUTO_TTS_IN_MESSAGE=
# 语音识别的本地模型目录与类型（默认为 models/faster-whisper，见 config/asr_config.json）
#ASR_MODEL_PATH=
#ASR_MODEL_TYPE=

# ── 3. 本地模型与硬件 ────────────────────────────────────────────────────
# 本地文本模型的临时覆盖口子；不写则按 modeling.yaml 的 model.path 自动探测
#XIAOYOU_TEXT_MODEL_PATH=
# 本地生图底模的临时覆盖口子
#XIAOYOU_SD_MODEL_PATH=
# 生图后端：comfyui / forge / siliconflow（默认 comfyui，见 modeling.yaml 的 image_provider）
#XIAOYOU_IMAGE_PROVIDER=
# 完全禁用本地 LLM（纯云端模式）
#XIAOYOU_DISABLE_LOCAL_LLM=
# 启动时预加载本地 LLM
#XIAOYOU_START_LOCAL_LLM=
# C++ 调度器与 GPU worker
#XIAOYOU_ALLOW_CPP_LLM_WORKER=
#XIAOYOU_CPP_BACKEND=
# CUDA Toolkit 路径（Windows 上编译/加载 cpp 模块时用）
#CUDA_PATH=
# 显存/内存阈值与并发模型数（资源监控用）
#GPU_MEMORY_THRESHOLD=
#MODEL_MEMORY_THRESHOLD=
#MAX_MODELS=
#MAX_GENERATION_TOKENS=

# ── 4. 服务、前端与安全 ──────────────────────────────────────────────────
# 对外暴露的地址（Web 前端与隧道回源用）
#XIAOYOU_SERVER_PUBLIC_IP=
# 前端静态产物目录与项目根（容器/特殊部署时用）
#XIAOYOU_FRONTEND_DIST=
#XIAOYOU_PROJECT_ROOT=
# Web 访问令牌
#XIAOYOU_SECURITY_WEB_ACCESS_TOKEN=
# 只出 SFW 内容
#XIAOYOU_SFW_ONLY=
# 人设附加资料注入
#XIAOYOU_PERSONA_INJECT_EXTRAS=
#XIAOYOU_PERSONA_EXTRAS_MAX_CHARS=
# 图片下发方式（base64 / URL）
#XIAOYOU_SEND_IMAGE_BASE64=
#XIAOYOU_IMAGE_BASE64_MAX_BYTES=

# ── 5. QQ 适配器 ─────────────────────────────────────────────────────────
# 主用户 QQ 号（master QQ id），用于会话 ID 拼接、Obsidian 默认会话等。
# 代码中不再硬编码，必须在此配置。
XIAOYOU_QQ_MASTER_ID=
# 各角色绑定的 QQ 号（多号模式；留空表示该角色不启用 QQ）
#XIAOYOU_QQ_BOT_NUMBER=
#XIAOYOU_QQ_BOT_NUMBER_LING=
#XIAOYOU_QQ_BOT_NUMBER_YE=
#XIAOYOU_QQ_BOT_NUMBER_RUSHUANG=
#XIAOYOU_QQ_GROUP_ID=
# 默认人设文件（clients/bots/qq 用）
#XIAOYOU_QQ_PUBLIC_PERSONA_FILE=
# NapCat / OneBot 接入
#NAPCAT_ACCESS_TOKEN=
#XIAOYOU_ACCESS_TOKEN=
# QQ 消息断句与打字延迟等 70+ 个可调项见 clients/bots/qq/settings.py，
# 默认值即可用，通常不需要写进 .env：
#XIAOYOU_QQ_STRIP_MARKDOWN=
#XIAOYOU_QQ_STREAM_SPLIT=
#XIAOYOU_QQ_MAX_BUBBLE_LEN=

# ── 6. Telegram 适配器 ───────────────────────────────────────────────────
#TELEGRAM_BOT_TOKEN=
#ENABLE_TELEGRAM_VOICE=true
#ENABLE_TELEGRAM_VISION=true
#TELEGRAM_STRIP_MARKDOWN=true
# 主人 Telegram user id（多号/定向会话用）
#TELEGRAM_MASTER_USER_ID=
# 本机代理与超时（中国大陆常用）
#TELEGRAM_PROXY_URL=
#TELEGRAM_HTTP_TIMEOUT=
# 后端地址（adapter 与主程序不同机时才需要）
#XIAOYOU_WS_URL=
#XIAOYOU_HTTP_BASE_URL=
# 断句/流式编辑等可调项见 clients/bots/telegram/settings.py

# ── 7. 天气（和风天气 JWT）──────────────────────────────────────────────
# 1. 控制台创建项目，生成 Ed25519 密钥对，公钥上传到凭据
# 2. 私钥保存到 config/qweather_private_key.pem（.gitignore 已忽略 *.pem）
# 3. API Host 在控制台-设置里查看（每个开发者独立）
QWEATHER_API_HOST=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PROJECT_ID=
QWEATHER_PRIVATE_KEY_PATH=config/qweather_private_key.pem
QWEATHER_DEFAULT_LOCATION=

# ── 8. 网络、镜像与调试 ──────────────────────────────────────────────────
# HuggingFace 镜像（中国大陆建议保留）
#HF_ENDPOINT=https://hf-mirror.com
# 代理与证书
#OPENROUTER_PROXY_URL=
#NO_PROXY=
#REQUESTS_CA_BUNDLE=
#SSL_CERT_FILE=
# 演示 / 应急模式（demo 脚本会自动设置，一般不用手填）
#DEMO_MODE=
#XIAOYOU_DEMO_MODE=
#AVELINE_DEMO_MODE=
#EMERGENCY_MODE=
#DISABLE_BATCH_PROCESSING=
#FORCE_QUANTIZATION=
#SERVICE_DOWNGRADE_LEVEL=
# 仅编译 C 扩展（cpp_modules/cpp_memory_index）时生效的调试开关
#DEBUG=0
# 提交前扫描用的 gitleaks 可执行文件路径（默认从 PATH 找）
#XIAOYOU_GITLEAKS_BIN=
